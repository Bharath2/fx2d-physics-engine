#!/usr/bin/env bash
set -e

APP="Fx2D" 
BUILD_DIR="build"

CMD="${1:-build}"
CFG="${2:-Release}" 
EXTRA="${3:-}"

GEN=(); EXT="" 
case "$(uname -s)" in 
    MINGW*|MSYS*|CYGWIN*)
        GEN=(-G "MinGW Makefiles"); EXT=".exe" ;; 
esac

copy_bin() {
    src="$BUILD_DIR/$APP$EXT"; [ -f "$src" ] || src="$BUILD_DIR/$CFG/$APP$EXT"
    cp -f "$src" "./$APP$EXT"
    echo "Copied: $src -> ./$APP$EXT"
}

cfg() { cmake -S . -B "$BUILD_DIR" "${GEN[@]}" -DCMAKE_BUILD_TYPE="$CFG" $EXTRA; }
build() { cmake --build "$BUILD_DIR" --config "$CFG" --parallel; copy_bin; }

case "$CMD" in
  clean)   rm -rf "$BUILD_DIR" "./$APP$EXT" ;;
  debug)   CFG=Debug; rm -rf "$BUILD_DIR" "./$APP$EXT"; cfg; build ;;
  rebuild) rm -rf "$BUILD_DIR" "./$APP$EXT"; cfg; build ;;
  build|all) cfg; build ;;
  *) echo "usage: $0 [build|rebuild|debug|clean] [Release|Debug] [\"-DOPT=VAL …\"]"; exit 1 ;;
esac